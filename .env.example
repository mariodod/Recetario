# Servidor
PORT=8081
NODE_ENV=development

# Base de datos (local, ver README para levantarla con Docker)
MONGODB_URI=mongodb://localhost:27017/recetario

# Secreto de las sesiones. Genera uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto

# Importar recetas por url:  por defecto solo se aceptan paginas publicas.
# Pon esto a "si" si quieres probar el importador contra un servidor local
# (la suite de pruebas lo hace); en produccion se queda sin definir.
# IMPORTAR_PERMITE_LOCAL=si
